# Base de datos (Supabase → Project Settings → Database → Connection pooler, puerto 6543)
DATABASE_URL=postgres://postgres.xxxx:password@aws-0-us-west-1.pooler.supabase.com:6543/postgres
# URL pública de la app (Vercel)
APP_URL=https://hostapp.vercel.app
# Firma de sesiones del panel (cadena larga al azar)
AUTH_SECRET=
# Código para crear restaurantes nuevos en /signup (piloto cerrado)
SIGNUP_INVITE_CODE=
# Claude (cerebro de Casia). Opcionales: VOICE_MODEL (rápido) y WORK_MODEL (leer menús / resúmenes)
ANTHROPIC_API_KEY=
# Vapi (voz). El secreto va en la URL del Custom LLM. ANA_ASSISTANT_ID solo lo usa scripts/vapi-setup.ts
VOICE_WEBHOOK_SECRET=
VAPI_API_KEY=
ANA_ASSISTANT_ID=
# Twilio (SMS de confirmación, links y avisos al dueño). SMS_DRY_RUN=1 = no manda nada, solo lo registra
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_DRY_RUN=1
# Stripe Connect (links de pago y depósitos). PLATFORM_FEE_BPS = comisión de HostApp (100 = 1%)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PLATFORM_FEE_BPS=0
# Vercel Cron (alertas diarias)
CRON_SECRET=
